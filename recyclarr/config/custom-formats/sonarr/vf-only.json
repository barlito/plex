{
    "trash_id": "fr-vf-only",
    "name": "VF only",
    "includeCustomFormatWhenRenaming": false,
    "specifications": [
        {
            "name": "VF tags",
            "implementation": "ReleaseTitleSpecification",
            "negate": false,
            "required": false,
            "fields": {
                "value": "\\b(VFF|VF2|VFI|VFB|VFQ|VQ|TRUEFRENCH)\\b"
            }
        },
        {
            "name": "FRENCH",
            "implementation": "ReleaseTitleSpecification",
            "negate": false,
            "required": false,
            "fields": {
                "value": "\\bFRENCH\\b"
            }
        },
        {
            "name": "Not MULTi",
            "implementation": "ReleaseTitleSpecification",
            "negate": true,
            "required": true,
            "fields": {
                "value": "\\bMULTi(?![ ._-]?sub(s)?)(\\b|\\d)"
            }
        },
        {
            "name": "Not French subs",
            "implementation": "ReleaseTitleSpecification",
            "negate": true,
            "required": true,
            "fields": {
                "value": "\\b(VOST[ .]?FR(E|A)?|STFR|SUBFR(A|ENCH)?|(SUB|ST)[ .]?FRENCH|FRENCH[ .]?SUBS?)\\b"
            }
        }
    ]
}
