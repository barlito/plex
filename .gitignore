.idea

emby/config/*
!emby/config/.gitkeep

filebrowser/*
!filebrowser/.gitkeep

jellyfin/config/*
!jellyfin/config/.gitkeep

# On ignore les médias mais on garde l'arborescence : il faut re-autoriser les
# dossiers eux-mêmes (`!.../*/`), sinon git ne descend jamais dedans et les
# négations sur les .gitkeep sont sans effet.
medias/complete/**
medias/incoming/**
medias/incomplete/**
!medias/.gitkeep
!medias/complete/.gitkeep
!medias/complete/*/
!medias/complete/**/.gitkeep
!medias/incoming/.gitkeep
!medias/incomplete/.gitkeep

plex/config/*
!plex/config/.gitkeep

prowlarr/config/*
!prowlarr/config/.gitkeep

bazarr/config/*
!bazarr/config/.gitkeep

radarr/config/*
!radarr/config/.gitkeep

sonarr/config/*
!sonarr/config/.gitkeep

transmission/config/*
transmission/watch/*
!transmission/config/.gitkeep
!transmission/watch/.gitkeep

ubooquity/config/*
!ubooquity/config/.gitkeep
