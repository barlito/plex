.idea

emby/config/*
!emby/config/.gitkeep

filebrowser/*
!filebrowser/.gitkeep

jellyfin/config/*
!jellyfin/config/.gitkeep

# Directories must be re-included (`!.../*/`) for the .gitkeep negations to apply.
medias/complete/**
medias/incoming/**
medias/cross-seed/**
medias/incomplete/**
!medias/.gitkeep
!medias/complete/.gitkeep
!medias/complete/*/
!medias/complete/**/.gitkeep
!medias/incoming/.gitkeep
!medias/incomplete/.gitkeep

plex/config/*
!plex/config/.gitkeep

prowlarr/config/*
!prowlarr/config/.gitkeep

bazarr/config/*
!bazarr/config/.gitkeep

radarr/config/*
!radarr/config/.gitkeep

sonarr/config/*
!sonarr/config/.gitkeep

seerr/config/*
!seerr/config/.gitkeep

transmission/config/*
transmission/watch/*
!transmission/config/.gitkeep
!transmission/watch/.gitkeep

ubooquity/config/*
!ubooquity/config/.gitkeep

cross-seed/config/*
!cross-seed/config/.gitkeep
!cross-seed/config/config.js
!cross-seed/config/secrets.env.example

recyclarr/config/*
!recyclarr/config/recyclarr.yml
!recyclarr/config/secrets.yml.example
!recyclarr/config/settings.yml
!recyclarr/config/custom-formats/
