# Copy to secrets.env (gitignored) and fill in. No quotes around values.
# Prowlarr: Settings > General > API Key.
CROSS_SEED_PROWLARR_API_KEY=changeme
# Comma-separated Prowlarr indexer ids (see docs/CROSS_SEED.md).
CROSS_SEED_PROWLARR_INDEXER_IDS=1
# Optional, 24 characters minimum. Only used to call the cross-seed HTTP API.
CROSS_SEED_API_KEY=
